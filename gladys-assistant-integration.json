          "placeholder": {
            "en": "e.g. Bondi or 2026",
            "fr": "ex. Bondi ou 2026",
            "de": "z. B. Bondi oder 2026",
            "es": "p. ej. Bondi o 2026"
          },
          "required": true
        }
      ]
    }
