{
  "manifest_version": 1,
  "type": "weather",
  "name": "Bureau of Meteorology (BoM)",
  "description": {
    "en": "Australian weather from the Bureau of Meteorology: forecasts, observations and warnings.",
    "fr": "Météo australienne du Bureau of Meteorology : prévisions, observations et alertes.",
    "de": "Australisches Wetter vom Bureau of Meteorology: Vorhersagen, Messwerte und Warnungen.",
    "es": "Tiempo australiano del Bureau of Meteorology: pronósticos, observaciones y avisos."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/gboulvin/gladys-bom:1.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-BoM/main/cover.png",
  "categories": ["environment", "services"],
  "keywords": ["BoM", "Australia", "weather", "météo", "forecast", "warnings", "fire danger"],
  "countries": ["AU"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Weather, forecasts and warnings come from the public API of the Australian Bureau of Meteorology: no account, no API key, Australia only. Leave the location empty to use the position of your Gladys house.",
        "fr": "La météo, les prévisions et les alertes viennent de l'API publique du Bureau of Meteorology australien : pas de compte, pas de clé d'API, Australie uniquement. Laissez la localisation vide pour utiliser la position de votre maison Gladys.",
        "de": "Wetter, Vorhersagen und Warnungen stammen aus der öffentlichen API des australischen Bureau of Meteorology: kein Konto, kein API-Schlüssel, nur Australien. Lassen Sie den Ort leer, um die Position Ihres Gladys-Hauses zu verwenden.",
        "es": "El tiempo, los pronósticos y los avisos proceden de la API pública del Bureau of Meteorology australiano: sin cuenta, sin clave de API, solo Australia. Deje la ubicación vacía para usar la posición de su casa de Gladys."
      },
      "links": [
        {
          "url": "https://www.bom.gov.au/",
          "label": {
            "en": "Bureau of Meteorology",
            "fr": "Bureau of Meteorology",
            "de": "Bureau of Meteorology",
            "es": "Bureau of Meteorology"
          }
        },
        {
          "url": "https://www.bom.gov.au/australia/warnings/",
          "label": {
            "en": "Current warnings",
            "fr": "Alertes en cours",
            "de": "Aktuelle Warnungen",
            "es": "Avisos vigentes"
          }
        }
      ]
    },
    {
      "key": "location",
      "type": "string",
      "label": {
        "en": "Location",
        "fr": "Localisation",
        "de": "Ort",
        "es": "Ubicación"
      },
      "description": {
        "en": "Suburb, town, postcode or \"latitude,longitude\". Leave empty to use the position of your Gladys house.",
        "fr": "Banlieue, ville, code postal ou « latitude,longitude ». Laissez vide pour utiliser la position de votre maison Gladys.",
        "de": "Vorort, Stadt, Postleitzahl oder „Breite,Länge“. Leer lassen, um die Position Ihres Gladys-Hauses zu verwenden.",
        "es": "Barrio, ciudad, código postal o «latitud,longitud». Deje vacío para usar la posición de su casa de Gladys."
      },
      "placeholder": {
        "en": "e.g. Parramatta or 2150",
        "fr": "ex. Parramatta ou 2150",
        "de": "z. B. Parramatta oder 2150",
        "es": "p. ej. Parramatta o 2150"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "warning_check_minutes",
      "type": "number",
      "label": {
        "en": "Warning check interval (min)",
        "fr": "Intervalle de vérification des alertes (min)",
        "de": "Prüfintervall für Warnungen (min)",
        "es": "Intervalo de comprobación de avisos (min)"
      },
      "description": {
        "en": "How often warnings and the fire danger rating are checked to fire the scene triggers.",
        "fr": "Fréquence de vérification des alertes et du danger d'incendie, pour déclencher les scènes.",
        "de": "Wie oft Warnungen und Brandgefahr geprüft werden, um Szenen auszulösen.",
        "es": "Frecuencia de comprobación de avisos y peligro de incendio para activar las escenas."
      },
      "required": false,
      "default": 10,
      "min": 5,
      "max": 60
    },
    {
      "key": "fire_danger_alerts",
      "type": "boolean",
      "label": {
        "en": "Fire danger as weather alerts",
        "fr": "Danger d'incendie en alerte météo",
        "de": "Brandgefahr als Wetterwarnung",
        "es": "Peligro de incendio como alerta"
      },
      "description": {
        "en": "Report a fire danger rating of High, Extreme or Catastrophic as a Gladys weather alert.",
        "fr": "Signaler un danger d'incendie Élevé, Extrême ou Catastrophique comme alerte météo Gladys.",
        "de": "Eine Brandgefahr Hoch, Extrem oder Katastrophal als Gladys-Wetterwarnung melden.",
        "es": "Notificar un peligro de incendio Alto, Extremo o Catastrófico como alerta meteorológica de Gladys."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Read the latest observation of the configured location.",
        "fr": "Lit la dernière observation de la localisation configurée.",
        "de": "Liest die letzte Messung des konfigurierten Orts.",
        "es": "Lee la última observación de la ubicación configurada."
      },
      "timeout_seconds": 30
    },
    {
      "key": "search_location",
      "label": {
        "en": "Find a location",
        "fr": "Rechercher un lieu",
        "de": "Ort suchen",
        "es": "Buscar un lugar"
      },
      "description": {
        "en": "List the BoM places matching a name or a postcode.",
        "fr": "Liste les lieux du BoM correspondant à un nom ou un code postal.",
        "de": "Listet die BoM-Orte zu einem Namen oder einer Postleitzahl auf.",
